# Copy to .env (which is git-ignored). Never commit real keys.

# Who does the reasoning when you press buttons in the WEB UI.
#   none        (default) viewer mode: the web UI shows and reviews; your VS Code agent
#               reasons through the `synth` CLI. Needs no key, no login, no model.
#   mock        deterministic demo data, clearly labelled. `npm run dev:demo`.
#   claude-cli  your installed Claude Code CLI, headless, under YOUR subscription login.
#               Local and single-user. See docs/local-agent.md. `npm run agent:check`.
#   anthropic   the Anthropic API, billed to ANTHROPIC_API_KEY.
# There is no automatic fallback between these.
IDEA_SYNTH_PROVIDER=none

# Optional model alias/id for claude-cli (e.g. sonnet, opus) or anthropic.
IDEA_SYNTH_MODEL=

# claude-cli only: path to the official CLI if it is not on PATH; per-call timeout.
IDEA_SYNTH_CLAUDE_BIN=
IDEA_SYNTH_AGENT_TIMEOUT_MS=

# anthropic only. NOTE: the claude-cli provider deliberately withholds this variable from
# the child process so that a subscription job can never silently become an API-billed one.
ANTHROPIC_API_KEY=

# SQLite database shared by the server, its workers and the CLI (relative to the repo root).
IDEA_SYNTH_DB=./data/idea-synth.sqlite

# The server binds to loopback. There are no user accounts: do not expose it.
HOST=127.0.0.1
PORT=8787
IDEA_SYNTH_JOB_CONCURRENCY=2
# IDEA_SYNTH_SEED=off   # do not seed the demo idea into an empty database
