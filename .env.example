# Copy to .env (which is git-ignored). Never commit real keys.

# AI provider: "mock" (default, deterministic, no network) or "anthropic".
IDEA_SYNTH_PROVIDER=mock

# Only needed when IDEA_SYNTH_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional model override for the anthropic provider.
IDEA_SYNTH_MODEL=

# SQLite database file. Use ":memory:" for a throwaway database.
IDEA_SYNTH_DB=./data/idea-synth.sqlite

# API port (the Vite dev server proxies /api to this).
PORT=8787
